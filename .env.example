# Optional. Canonical URL for metadata, sitemap, and robots.
# Defaults to https://lifewithai.co.uk when unset.
NEXT_PUBLIC_SITE_URL=https://lifewithai.co.uk

# Optional. MailerLite (same account as hillmade.uk, its own Life with AI group).
# The email signup form only appears when all three are set; without them the
# site shows a "list opens soon" note. Set the last one to true ONLY after
# turning on Double opt-in for API and integrations in MailerLite.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
MAILERLITE_DOUBLE_OPT_IN_CONFIRMED=false

# Optional. Search engine ownership tags: the content="..." value from each
# console's "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
